"""
Exemplos de Requisições HTTP para a API GISA
Base URL: http://localhost:8080/gisa-api
"""

### ============================================
### 1. PACIENTES
### ============================================

### Criar Paciente (POST)
POST http://localhost:8080/gisa-api/api/pacientes
Content-Type: application/json

{
  "nome": "Maria Silva",
  "cpf": "12345678901",
  "dataNascimento": "2005-03-20",
  "sexo": "F",
  "celular": "11987654321",
  "estadoCivil": "SOLTEIRO",
  "statusCadastro": "ATIVO",
  "statusPaciente": "DESLIGADO",
  "tipoEntrada": "PRIMEIRA_VEZ",
  "dataCadastro": "2024-05-20",
  "convenio": false
}

### Listar Todos os Pacientes (GET)
GET http://localhost:8080/gisa-api/api/pacientes

### Buscar Paciente por ID (GET)
GET http://localhost:8080/gisa-api/api/pacientes/1

### Buscar Paciente por CPF (GET)
GET http://localhost:8080/gisa-api/api/pacientes/cpf/12345678901

### Atualizar Paciente (PUT)
PUT http://localhost:8080/gisa-api/api/pacientes/1
Content-Type: application/json

{
  "nome": "Maria Silva Santos",
  "statusPaciente": "ATIVO"
}

### Deletar Paciente (DELETE)
DELETE http://localhost:8080/gisa-api/api/pacientes/1

---

### ============================================
### 2. PROFISSIONAIS
### ============================================

### Criar Profissional (POST)
POST http://localhost:8080/gisa-api/api/profissionais
Content-Type: application/json

{
  "nome": "Dr. João Santos",
  "cpf": "98765432100",
  "dataNascimento": "1985-07-10",
  "sexo": "M",
  "celular": "11999999999",
  "estadoCivil": "CASADO",
  "statusCadastro": "ATIVO",
  "cargo": {
    "idCargo": 1
  }
}

### Listar Todos os Profissionais (GET)
GET http://localhost:8080/gisa-api/api/profissionais

### Buscar por CPF (GET)
GET http://localhost:8080/gisa-api/api/profissionais/cpf/98765432100

---

### ============================================
### 3. ESPECIALISTAS
### ============================================

### Criar Especialista (POST)
POST http://localhost:8080/gisa-api/api/especialistas
Content-Type: application/json

{
  "nome": "Dra. Ana Paula",
  "cpf": "55555555555",
  "dataNascimento": "1980-05-15",
  "sexo": "F",
  "celular": "11988888888",
  "estadoCivil": "SOLTEIRO",
  "statusCadastro": "ATIVO",
  "registroConselho": "CRP/12345",
  "cargo": {
    "idCargo": 2
  },
  "especialidades": [
    {"idEspecialidade": 1},
    {"idEspecialidade": 2}
  ]
}

### Listar Todos os Especialistas (GET)
GET http://localhost:8080/gisa-api/api/especialistas

---

### ============================================
### 4. TERAPIAS
### ============================================

### Criar Terapia (POST)
POST http://localhost:8080/gisa-api/api/terapias
Content-Type: application/json

{
  "data": "2024-05-20",
  "descricao": "Sessão de psicoterapia individual",
  "statusTerapia": "AGENDADA",
  "modalidade": {
    "idModalidade": 1
  },
  "pacientes": [
    {"idCadastro": 1}
  ],
  "especialistas": [
    {"idCadastro": 3}
  ]
}

### Listar Todas as Terapias (GET)
GET http://localhost:8080/gisa-api/api/terapias

### Atualizar Terapia (PUT)
PUT http://localhost:8080/gisa-api/api/terapias/1
Content-Type: application/json

{
  "statusTerapia": "REALIZADA",
  "descricao": "Sessão realizada com sucesso"
}

---

